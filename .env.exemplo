# ============================================================
# MODELO — copie para `.env` e preencha. Este arquivo VAI para o git;
# o `.env` NAO vai. Nunca escreva um token real aqui.
# ============================================================
# Caminhos de onde tirar cada credencial: docs/integracoes/ekyte.md

# --- Ekyte: leitura (REST, 16 endpoints GET) --------------------------
# avatar > Minha empresa > Data-driven > Integracao com Power BI
# ATENCAO: a API espera a palavra "Bearer" DENTRO do valor do parametro:
#   https://api.ekyte.com/v1.2/tasks?apiKey=Bearer SEU_TOKEN&page=1
# Guarde aqui SO o token, sem o "Bearer" — o codigo monta a string.
EKYTE_API_KEY=

# --- Ekyte: escrita (MCP, 96 ferramentas) -----------------------------
# avatar > Perfil de acesso > Integracoes MCP > copiar URL do servidor
# A URL ja vem com o token embutido. Cole a URL INTEIRA.
# Formato: https://api.ekyte.com/mcp?token=XXXXXXXX
EKYTE_MCP_URL=

# --- Ekyte: escrita alternativa (Zapier / n8n) ------------------------
# avatar > Minha empresa > Avancado > Integracao Zapier/n8n
# Plano B se o conector MCP nao estiver habilitado para a empresa.
# A unidade tem n8n proprio — este e o caminho por ele ou pelo Zapier.
EKYTE_AUTOMACAO_TOKEN=

# --- n8n da unidade ---------------------------------------------------
# URL base da instancia propria da BFG&Co (NAO a do Rony, que roda o Cockpit)
N8N_BASE_URL=
N8N_API_KEY=

# --- Meta Ads: leitura (Marketing API) -------------------------------
# Token de USUARIO DE SISTEMA, permissao ads_read, sem expiracao.
# business.facebook.com > Configuracoes do negocio > Usuarios do sistema
# > (usuario de leitura) > Gerar novo token. Passo a passo: docs/integracoes/meta.md
META_ACCESS_TOKEN=

# --- Google Ads: leitura (API REST, usada por scripts/metricas.py) --------
# Developer token (Basic Access) + MCC + caminho do adc.json. Passo a passo: docs/integracoes/google-ads.md
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
GOOGLE_APPLICATION_CREDENTIALS=
